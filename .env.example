# Turso Veritabani (ZORUNLU - Vercel icin)
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-token

# Site URL (e-posta bildirimlerinde kullanilir)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# E-posta bildirimi (Resend - https://resend.com)
RESEND_API_KEY=
RESEND_FROM=e-Belediye <noreply@yourdomain.com>
ADMIN_EMAIL=belediye@example.com

# SMS bildirimi (Twilio - istege bagli)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Dosya yukleme (Vercel Blob - Vercel dashboard'dan otomatik eklenir)
BLOB_READ_WRITE_TOKEN=

# Yonetici paneli
ADMIN_PASSWORD=dortyol2024
ADMIN_SECRET=your-admin-session-secret
ADMIN_DEPARTMAN=

# OpenAI (asistan / chatbot - istege bagli)
OPENAI_API_KEY=
